// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Job {
  id              String   @id @default(uuid())
  jobId           String
  title           String
  companyName     String
  companyFullName String?
  companyId       String?
  salary          String
  location        String
  education       String?
  platform        String
  status          String   @default("normal")
  rawData         String
  rawData2        String?
  dataSource      String   @default("unknown")
  
  // 与职位强绑定的状态
  isFavorited  Boolean  @default(false)
  isHidden     Boolean  @default(false)
  tags         String?  // JSON string
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // 职位生命周期与变动追踪
  firstSeen           DateTime @default(now())
  lastSeen            DateTime @default(now())
  descHash            String?
  platformPublishTime String?  // 源站官方职位首次发布时间（如：2026-08-20、08月20日）
  platformUpdateTime  String?  // 源站官方职位最后刷新/更新时间（如：刚刚刷新、2026-08-25）
  
  // HR 活跃度分析与僵尸岗识别
  hrActiveStatus String?  // 原始活跃描述，如：3分钟前在线、3日内活跃
  hrActiveLevel  String?  // active (活跃), moderate (适中), zombie (僵尸岗), unknown (未知)
  hrName         String?  // 招聘人姓名
  hrPosition     String?  // 招聘人职位
  
  // 猎头/代招标记
  isHeadhunter   Boolean? @default(false)

  // 阶段一新增：结构化薪资 (千元/月数值，用于毫秒级范围查询与排序)
  salaryMin      Float?
  salaryMax      Float?
  salaryAvg      Float?
  salaryMonths   Int?     @default(12)

  // 阶段一新增：结构化地理位置
  province       String?
  city           String?
  area           String?
  businessDistrict String?
  address        String?

  // 阶段一新增：结构化经验要求
  experience     String?
  expMinYears    Int?     @default(0)
  expMaxYears    Int?

  // 阶段一新增：结构化标签 (JSON 字符串形式保存数组)
  skills         String?  // JSON string: string[]
  welfareList    String?  // JSON string: string[]

  // 阶段一新增：解耦的求职跟进状态 (看板状态)
  applyStatus    String?  @default("none") // none, to-apply, applied, interview-1, interview-2, offer, rejected
  appliedAt      DateTime?
  statusUpdatedAt DateTime?

  // 关联的面试记录 (强绑定，随职位删除而删除)
  interviews     Interview[]

  // 阶段一新增：关联冷数据大字段与状态流转历史
  detailPayload  JobDetailPayload?
  statusLogs     JobStatusLog[]

  @@unique([jobId, platform])
  @@index([firstSeen])
  @@index([lastSeen])
  @@index([hrActiveLevel])
  @@index([isHeadhunter])
  @@index([status, isHidden, isFavorited])
  @@index([applyStatus])
  @@index([city])
  @@index([salaryAvg])
  @@index([updatedAt])
}

// 阶段一新增：职位冷数据附表 (存储大文本与原始抓取快照，保持 Job 主表轻量)
model JobDetailPayload {
  id          String   @id @default(uuid())
  jobRecordId String   @unique
  job         Job      @relation(fields: [jobRecordId], references: [id], onDelete: Cascade)
  jobDesc     String?
  jobUrl      String?
  rawData     String?
  rawData2    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("job_detail_payloads")
}

// 阶段一新增：投递进度流转日志表 (记录看板拖拽与状态流转历史)
model JobStatusLog {
  id          String   @id @default(uuid())
  jobRecordId String
  job         Job      @relation(fields: [jobRecordId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  note        String?
  createdAt   DateTime @default(now())

  @@index([jobRecordId])
  @@index([toStatus, createdAt])
  @@map("job_status_logs")
}

// 独立的 AI 结果表（脱离职位独立存在，不设强外键）
model AiJobResult {
  jobId        String   @id
  score        Int?
  matchLevel   String?
  resultText   String?
  intro        String?
  predictedQuestions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 独立的公司信息表
model Company {
  id              String   @id @default(uuid())
  companyName     String
  companyFullName String?
  companyId       String?
  sourcePlatform  String
  
  // 结构化企业字段
  industry        String?  // 所属行业（如：互联网、整车制造、金融、电子商务）
  scale           String?  // 企业规模（如：100-499人、1000-9999人、10000人以上）
  stage           String?  // 融资阶段（如：已上市、不需要融资、D轮及以上、天使轮）
  companyType     String?  // 企业性质（如：民营企业、国企、外商独资/合资、上市公司）
  creditCode      String?  // 统一社会信用代码（18位唯一工商识别码）
  logo            String?  // 企业Logo图标URL或文件名
  welfareList     String?  // 企业福利待遇标签（JSON 数组字符串）
  
  rawData         String?  // 来源1：职位列表页抓取的完整基础快照JSON
  rawData2        String?  // 来源3：公司主页抓取的全景工商信息JSON
  rawData3        String?  // 来源2：职位详情页附带提取的企业快照JSON
  isAgency        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyName, sourcePlatform, companyId])
  @@index([industry])
  @@index([scale])
  @@index([stage])
  @@index([creditCode])
}

model Interview {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  time      DateTime
  type      String   // 面试方式: 电话, 视频, 现场
  round     String   // 面试轮次: 一面, 二面, HR面等
  note      String?  // 备注/地址等
  debrief   String?  // 复盘内容
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlacklistedCompany {
  companyName String   @id
  reason      String?
  source      String?  @default("manual") // "chat_rejection", "manual"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StandardQuestion {
  id              String   @id @default(uuid())
  title           String
  domain          String?
  categoryTags    String?
  corePoints      String?
  answerKey       String?
  aiAnswer        String?
  tags            String?  // JSON string
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants        QuestionVariant[]
}

model QuestionVariant {
  id                 String           @id @default(uuid())
  standardQuestionId String
  standardQuestion   StandardQuestion @relation(fields: [standardQuestionId], references: [id], onDelete: Cascade)
  serialNo           Int?
  title              String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model AiSettings {
  id              String   @id @default("default")
  activeProfileId String
  profiles        String   // JSON string of all profiles
  resume          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ZhilianEnrichmentCache {
  jobId     String   @id
  rawData   String   // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobDetail {
  id        String   @id @default(uuid())
  jobId     String
  platform  String
  rawData   String   // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, platform])
  @@map("job_details")
}

model AiSkill {
  id              String   @id @default(uuid())
  name            String
  description     String?
  systemPrompt    String
  userPrompt      String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
